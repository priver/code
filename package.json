{
  "name": "code",
  "private": true,
  "type": "module",
  "scripts": {
    "mkcert": "mkcert '*.priver.dev'",
    "format": "oxfmt",
    "check-format": "oxfmt --check",
    "check-deps": "sherif",
    "lint": "oxlint",
    "check": "turbo run check-format check-deps lint test",
    "build": "turbo run build",
    "serve": "caddy run",
    "dev:storybook": "turbo run dev --filter=@priver/storybook"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@priver/oxfmt-config": "workspace:*",
    "@priver/oxlint-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0"
}
