{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/*.html", "pnpm-lock.yaml", ".agents/skills/"],
  "singleQuote": true,
  "quoteProps": "consistent",
  "proseWrap": "always",
  "jsdoc": true,
  "sortImports": {
    "ignoreCase": false,
    "internalPattern": ["@priver/"],
    "groups": [
      "builtin",
      "external",
      "internal",
      "subpath",
      ["parent", "sibling", "index"],
      "style",
      "unknown",
    ],
  },
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/style.css",
    "functions": ["cva", "cx"],
  },
  "overrides": [
    {
      "files": [
        "**/CHANGELOG.md",
        ".changeset/*.md",
        "packages/eslint-config/TABLE_OF_COMPARISON.md",
      ],
      "options": {
        "proseWrap": "preserve",
      },
    },
  ],
}
